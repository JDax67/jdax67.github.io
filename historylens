  } catch(err) {
    // Clear key on auth errors
    if (err.message.includes('401') || err.message.includes('403') || err.message.toLowerCase().includes('invalid') || err.message.toLowerCase().includes('unauthorized')) {
      aiApiKey = '';
      aiGenerated = false;
      updateAiKeyBtn();
    }
    document.getElementById('aiGenerating').style.display = 'none';
    document.getElementById('aiContent').innerHTML =
      `<span style="color:var(--danger)">⚠ Analysis failed.</span>\n\n${esc(err.message)}\n\n<span style="color:var(--muted)">Click "Add API Key" above to check your key.</span>`;
  }
}

function renderAIResponse(text) {
  // Extract score for score cards
  const scoreMatch = text.match(/=== PRODUCTIVITY SCORE ===\s*(\d+)\/100/);
  if (scoreMatch) {
    const score = parseInt(scoreMatch[1]);
    const color = score >= 70 ? 'var(--success)' : score >= 40 ? 'var(--accent3)' : 'var(--danger)';
    const total = allEntries.length;
    const social = allEntries.filter(e => e.type === 'social').length;
    const searches = allEntries.filter(e => e.type === 'search').length;
    const focusPct = Math.round(((total - social) / Math.max(total, 1)) * 100);
    const scoresEl = document.getElementById('aiScores');
    scoresEl.classList.remove('hidden');
    scoresEl.innerHTML = `
      <div class="ai-score-card"><div class="ai-score-val" style="color:${color}">${score}</div><div class="ai-score-label">Productivity</div></div>
      <div class="ai-score-card"><div class="ai-score-val" style="color:var(--accent)">${focusPct}%</div><div class="ai-score-label">Focus Rate</div></div>
      <div class="ai-score-card"><div class="ai-score-val" style="color:#a78bfa">${searches}</div><div class="ai-score-label">Searches</div></div>
      <div class="ai-score-card"><div class="ai-score-val" style="color:var(--accent3)">${new Set(allEntries.map(e=>e.domain)).size}</div><div class="ai-score-label">Domains</div></div>`;
  }

  // Format sections into styled HTML
  const formatted = text
    .replace(/=== (.+?) ===/g, '<span class="ai-section-title">$1</span>')
    .replace(/•/g, '  •')
    .replace(/→/g, '  →');

  const contentEl = document.getElementById('aiContent');
  contentEl.innerHTML = `<span id="aiReveal">${formatted}</span>`;
  contentEl.style.animation = 'fadeIn 0.5s ease';
}

function buildAISummary() {
  const total = allEntries.length;
  const days = [...new Set(allEntries.map(e => e.dateObj.toISOString().slice(0,10)))];
  const domains = {};
  allEntries.forEach(e => { domains[e.domain] = (domains[e.domain]||0)+1; });
  const topDomains = Object.entries(domains).sort((a,b)=>b[1]-a[1]).slice(0,10);
  const searches = allEntries.filter(e => e.type === 'search');
  const dls = allEntries.filter(e => e.type === 'download');
  const social = allEntries.filter(e => e.type === 'social');
  const video = allEntries.filter(e => e.type === 'video');
  const sq = searches.map(e => { try { return new URL(e.url).searchParams.get('q')||''; } catch { return ''; } }).filter(Boolean).slice(0,15);
  const ph = {};
  allEntries.forEach(e => { const h = e.dateObj.getUTCHours(); ph[h]=(ph[h]||0)+1; });
  const peak = Object.entries(ph).sort((a,b)=>b[1]-a[1])[0];

  return `Total visits: ${total}
Days analyzed: ${days.length} (${days[0]} to ${days[days.length-1]})
Avg visits/day: ${(total/Math.max(days.length,1)).toFixed(1)}
Peak hour UTC: ${peak ? peak[0]+':00 ('+peak[1]+' visits)' : 'unknown'}
Top domains: ${topDomains.map(([d,c])=>d+'('+c+')').join(', ')}
Searches: ${searches.length} | Social: ${social.length} | Video: ${video.length} | Downloads: ${dls.length} | Pages: ${total-searches.length-social.length-video.length-dls.length}
Search queries: ${sq.join(' | ')}
Downloads: ${dls.map(e=>fname(e.url)).slice(0,10).join(', ')}`.trim();
}

// ── CLEAR ──────────────────────────────────────────────────────────
function clearAllData(){
  if(!confirm('Clear all data and start over? This removes everything from memory.'))return;
  allEntries=[];activeFilter='all';vtCache={};aiGenerated=false;
  document.getElementById('mainContent').style.display='none';
  document.getElementById('uploadSection').style.display='block';
  document.getElementById('fileInput').value='';
  document.getElementById('exportCount').textContent='';
  ['timeline','domainGrid','downloadsTimeline','report','statsBar','aiPanel'].forEach(id=>{const el=document.getElementById(id);if(el)el.innerHTML='';});
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  document.querySelector('.tab[data-tab="timeline"]').classList.add('active');
  document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
  document.getElementById('panel-timeline').classList.add('active');
  document.querySelectorAll('.filter-btn').forEach(b=>b.classList.remove('on'));
  document.querySelector('.filter-btn[data-filter="all"]').classList.add('on');
  window.scrollTo({top:0,behavior:'smooth'});
}

// ── EXPORTS ────────────────────────────────────────────────────────
function exportCSV(){
  const rows=allEntries.map(e=>[e.dateObj.toISOString().slice(0,10),e.dateObj.toISOString().slice(11,16)+' UTC',`"${(e.title||'').replace(/"/g,'""')}"`,`"${(e.url||'').replace(/"/g,'""')}"`,e.domain,e.type]);
  dlFile([['Date','Time','Title','URL','Domain','Type'].join(','),...rows.map(r=>r.join(','))].join('\n'),'historylens-export.csv','text/csv');
}
function exportJSON(){
  dlFile(JSON.stringify({exported_at:new Date().toISOString(),total_entries:allEntries.length,summary:{unique_domains:new Set(allEntries.map(e=>e.domain)).size,downloads:allEntries.filter(e=>e.type==='download').length,searches:allEntries.filter(e=>e.type==='search').length,days_tracked:new Set(allEntries.map(e=>e.dateObj.toISOString().slice(0,10))).size},entries:allEntries.map(e=>({timestamp:e.time,title:e.title,url:e.url,domain:e.domain,type:e.type}))},null,2),'historylens-export.json','application/json');
}
function dlFile(content,name,mime){const b=new Blob([content],{type:mime});const u=URL.createObjectURL(b);const a=document.createElement('a');a.href=u;a.download=name;document.body.appendChild(a);a.click();document.body.removeChild(a);URL.revokeObjectURL(u);}

// ── HELPERS ────────────────────────────────────────────────────────
function fmtT(d){if(!(d instanceof Date)||isNaN(d))return'--:--';return d.toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit',timeZone:'UTC'})+' UTC';}
function fmtD(d){if(!(d instanceof Date)||isNaN(d))return'';return d.toLocaleDateString('en-GB',{month:'short',day:'numeric',timeZone:'UTC'});}
function fmtDH(s){const d=new Date(s);return d.toLocaleDateString('en-GB',{weekday:'long',year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})+' (UTC)';}
function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function fname(url){try{const p=new URL(url).pathname;return p.split('/').pop()||url;}catch{return url;}}
function ext(url){const m=url.match(/\.([a-z0-9]+)(\?|$)/i);return m?m[1].toUpperCase():'FILE';}
