async function scanWithVT(url, btnEl) {
  if (!vtApiKey) { openVtModal(); return; }
  if (vtCache[url]) { renderVtResult(url, vtCache[url]); return; }
  btnEl.disabled = true; btnEl.textContent = '...';
  try {
    const sub = await fetch('https://www.virustotal.com/api/v3/urls', {
      method:'POST',
      headers:{'x-apikey':vtApiKey,'Content-Type':'application/x-www-form-urlencoded'},
      body:'url='+encodeURIComponent(url)
    });
    if (!sub.ok) throw new Error('Submit failed: '+sub.status);
    const subData = await sub.json();
    const id = subData?.data?.id;
    if (!id) throw new Error('No analysis ID');
    let result = null;
    for (let i=0; i<3; i++) {
      await new Promise(r=>setTimeout(r,2000));
      const rep = await fetch(`https://www.virustotal.com/api/v3/analyses/${id}`,{headers:{'x-apikey':vtApiKey}});
      if (!rep.ok) continue;
      const repData = await rep.json();
      if (repData?.data?.attributes?.status==='completed') { result=repData.data.attributes.stats; break; }
    }
    if (!result) throw new Error('Timed out — try again');
    const r = {malicious:result.malicious||0,suspicious:result.suspicious||0,harmless:result.harmless||0};
    vtCache[url]=r; renderVtResult(url,r);
  } catch(err) {
    document.querySelectorAll('.vt-btn').forEach(b=>{
      if(b.dataset.url===url){const s=document.createElement('span');s.className='vt-result vt-error';s.title=err.message;s.textContent='⚠ Error';b.replaceWith(s);}
    });
  }
}

function renderVtResult(url, s) {
  document.querySelectorAll('.vt-btn').forEach(b=>{
    if(b.dataset.url!==url) return;
    const badge=document.createElement('span');
    badge.className='vt-result '+(s.malicious>0?'vt-malicious':s.suspicious>0?'vt-suspicious':'vt-clean');
    badge.title=`Malicious:${s.malicious} · Suspicious:${s.suspicious} · Clean:${s.harmless}`;
    badge.textContent=s.malicious>0?`🔴 ${s.malicious} malicious`:s.suspicious>0?`⚠ ${s.suspicious} suspicious`:'✅ Clean';
    b.replaceWith(badge);
  });
}

