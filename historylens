// ── FILE READING ───────────────────────────────────────────────────
function readFile(file) {
  const ext = file.name.split('.').pop().toLowerCase();
  if (['db','sqlite','sqlite3'].includes(ext) || /history|places/i.test(file.name)) {
    document.getElementById('loadingOverlay').classList.remove('hidden');
    document.getElementById('loadingSubtext').textContent = 'Loading WebAssembly engine...';
    const reader = new FileReader();
    reader.onload = async ev => {
      try {
        document.getElementById('loadingSubtext').textContent = 'Querying history tables...';
        const entries = await parseSQLite(new Uint8Array(ev.target.result));
        document.getElementById('loadingOverlay').classList.add('hidden');
        if (!entries.length) { alert('No history found. Ensure this is a Chrome/Firefox/Safari history database.'); return; }
        processEntries(entries);
      } catch(err) {
        document.getElementById('loadingOverlay').classList.add('hidden');
        alert('Could not read SQLite: ' + err.message);
      }
    };
    reader.readAsArrayBuffer(file);
    return;
  }
  const reader = new FileReader();
  reader.onload = ev => {
    const text = ev.target.result;
    let entries = [];
    try { entries = parseChrome(JSON.parse(text)); } catch { entries = text.includes(',') ? parseCsv(text) : parseTxt(text); }
    if (!entries.length) { alert('Could not parse file. Try loading sample data to see expected format.'); return; }
    processEntries(entries);
  };
  reader.readAsText(file);
}

// ── SQLITE PARSERS ─────────────────────────────────────────────────
async function parseSQLite(bytes) {
  const SQL = await initSqlJs({locateFile:f=>`https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.10.2/${f}`});
  const db = new SQL.Database(bytes);
  const tables = db.exec("SELECT name FROM sqlite_master WHERE type='table'");
  const tn = tables[0]?.values?.flat().map(t=>String(t).toLowerCase())||[];
  let entries = [];
  if (tn.includes('urls')&&tn.includes('visits')) entries=parseChromeDB(db);
  else if (tn.includes('moz_places')) entries=parseFirefoxDB(db);
  else if (tn.includes('history_items')&&tn.includes('history_visits')) entries=parseSafariDB(db);
  else entries=parseGenericDB(db,tn);
  db.close(); return entries;
}
function parseChromeDB(db) {
  const OFF=11644473600000;
  try {
    const r=db.exec(`SELECT u.url,u.title,v.visit_time FROM urls u LEFT JOIN visits v ON u.id=v.url WHERE u.url IS NOT NULL ORDER BY v.visit_time ASC`);
    if(!r[0]) return [];
    return r[0].values.map(([url,title,vt])=>({url:String(url||''),title:String(title||url||''),time:new Date((Number(vt)/1000)-OFF).toISOString(),download:isDL(String(url||''))})).filter(e=>e.url.startsWith('http'));
  } catch{return [];}
}
function parseFirefoxDB(db) {
  try {
    const r=db.exec(`SELECT p.url,p.title,h.visit_date FROM moz_places p LEFT JOIN moz_historyvisits h ON p.id=h.place_id WHERE p.url IS NOT NULL AND p.hidden=0 ORDER BY h.visit_date ASC`);
    if(!r[0]) return [];
    return r[0].values.map(([url,title,vd])=>({url:String(url||''),title:String(title||url||''),time:new Date(Number(vd)/1000).toISOString(),download:isDL(String(url||''))})).filter(e=>e.url.startsWith('http'));
  } catch{return [];}
}
function parseSafariDB(db) {
  try {
    const AE=978307200000;
    const r=db.exec(`SELECT i.url,v.visit_time FROM history_items i LEFT JOIN history_visits v ON i.id=v.history_item ORDER BY v.visit_time ASC`);
    if(!r[0]) return [];
    return r[0].values.map(([url,vt])=>({url:String(url||''),title:String(url||''),time:new Date((Number(vt)*1000)+AE).toISOString(),download:isDL(String(url||''))})).filter(e=>e.url.startsWith('http'));
  } catch{return [];}
}
function parseGenericDB(db,tn) {
  for(const t of tn){
    try{
      const c=db.exec(`PRAGMA table_info(${t})`);if(!c[0])continue;
      const cn=c[0].values.map(r=>String(r[1]).toLowerCase());
      const uc=cn.find(c=>c.includes('url')||c.includes('address'));if(!uc)continue;
      const tc=cn.find(c=>c.includes('title')||c.includes('name'));
      const dc=cn.find(c=>c.includes('time')||c.includes('date')||c.includes('visit'));
      const r=db.exec(`SELECT ${[uc,tc||uc,dc||'null'].join(',')} FROM ${t} LIMIT 5000`);
      if(!r[0]||!r[0].values.length)continue;
      return r[0].values.map(row=>{const url=String(row[0]||'');const ms=row[2]?(String(row[2]).length>12?Number(row[2])/1000:Number(row[2])*1000):Date.now();return{url,title:String(row[1]||url),time:new Date(isNaN(ms)?Date.now():ms).toISOString(),download:isDL(url)};}).filter(e=>e.url.startsWith('http'));
    }catch{continue;}
  }
  return [];
}
function parseChrome(json) {
  if(Array.isArray(json)) return json.map(e=>({time:e.time_usec?new Date(e.time_usec/1000).toISOString():(e.visitTime||e.lastVisitTime||e.time||''),url:e.url||'',title:e.title||e.url||'',download:isDL(e.url||'')})).filter(e=>e.url);
  if(json.Browser_History) return parseChrome(json.Browser_History);
  return [];
}
function parseCsv(text) {
  const lines=text.trim().split('\n');
  const h=lines[0].toLowerCase().split(',').map(s=>s.trim().replace(/"/g,''));
  const ui=h.findIndex(s=>s.includes('url')||s.includes('address'));
  const ti=h.findIndex(s=>s.includes('title')||s.includes('name'));
  const di=h.findIndex(s=>s.includes('time')||s.includes('date')||s.includes('visit'));
  return lines.slice(1).map(line=>{const c=line.split(',').map(s=>s.trim().replace(/^"|"$/g,''));const url=c[ui]||c[0]||'';return{url,title:c[ti]||url,time:c[di]||new Date().toISOString(),download:isDL(url)};}).filter(e=>e.url&&e.url.startsWith('http'));
}
function parseTxt(text){return text.trim().split('\n').filter(l=>l.startsWith('http')).map(url=>({url:url.trim(),title:url.trim(),time:new Date().toISOString(),download:isDL(url)}));}
function isDL(url){return /\.(pdf|zip|tar|gz|rar|exe|dmg|pkg|deb|msi|xlsx?|docx?|pptx?|mp3|mp4|iso|apk|csv)(\?|$)/i.test(url)||url.includes('download')||url.includes('export=download');}

// ── PROCESS ────────────────────────────────────────────────────────
function processEntries(raw) {
  allEntries = raw.map(e=>({...e,dateObj:new Date(e.time),domain:getDomain(e.url),type:classify(e)})).sort((a,b)=>a.dateObj-b.dateObj);
  document.getElementById('uploadSection').style.display='none';
  document.getElementById('mainContent').style.display='block';
  document.getElementById('exportCount').textContent=allEntries.length.toLocaleString()+' entries ready';
  renderStats(); renderTimeline('all'); renderDomains(); renderDownloads(); renderReport();
  setTimeout(()=>document.querySelectorAll('.domain-bar-fill').forEach(el=>{el.style.width=el.dataset.width;}),100);
}
function getDomain(url){try{return new URL(url).hostname.replace('www.','');}catch{return url;}}
function classify(e){
  const u=e.url.toLowerCase();
  if(e.download||isDL(u)) return 'download';
  if(u.includes('google.com/search')||u.includes('bing.com/search')||u.includes('duckduckgo')||u.includes('search?q=')) return 'search';
  if(/twitter\.com|facebook\.com|instagram\.com|linkedin\.com|reddit\.com|tiktok\.com/.test(u)) return 'social';
  if(/youtube\.com|netflix\.com|twitch\.tv|hulu\.com|spotify\.com|vimeo\.com/.test(u)) return 'video';
  return 'page';
}

