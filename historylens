function renderReport(){
  const total=allEntries.length,dls=allEntries.filter(e=>e.type==='download'),searches=allEntries.filter(e=>e.type==='search'),social=allEntries.filter(e=>e.type==='social'),video=allEntries.filter(e=>e.type==='video');
  const domains={};allEntries.forEach(e=>{domains[e.domain]=(domains[e.domain]||0)+1;});
  const top=Object.entries(domains).sort((a,b)=>b[1]-a[1]).slice(0,5);
  const days=new Set(allEntries.map(e=>e.dateObj.toISOString().slice(0,10))).size;
  const ph={};allEntries.forEach(e=>{const h=e.dateObj.getUTCHours();ph[h]=(ph[h]||0)+1;});
  const peak=Object.entries(ph).sort((a,b)=>b[1]-a[1])[0];
  const sq=searches.map(e=>{try{return new URL(e.url).searchParams.get('q')||'';}catch{return '';}}).filter(Boolean).slice(0,8);
  const exe=dls.filter(e=>/\.(exe|dmg|pkg|deb|msi|apk)/i.test(e.url));
  const cards=[];
  cards.push(`<div class="report-card info"><div class="rc-head"><span class="rc-icon">📊</span><span class="rc-title">Activity Overview</span></div><div class="rc-body"><ul>
    <li>Analyzed <span class="highlight">${total} visits</span> across <span class="highlight">${days} day${days>1?'s':''}</span></li>
    <li>Average <span class="highlight">${(total/Math.max(days,1)).toFixed(1)} visits/day</span></li>
    <li>Peak hour: <span class="highlight">${peak?peak[0]+':00 UTC ('+peak[1]+' visits)':'N/A'}</span></li>
    <li>Browsed <span class="highlight">${Object.keys(domains).length} unique domains</span></li>
  </ul></div></div>`);
  cards.push(`<div class="report-card neutral"><div class="rc-head"><span class="rc-icon">🏆</span><span class="rc-title">Most Visited Sites</span></div><div class="rc-body"><ul>${top.map(([d,c])=>`<li><span class="highlight">${d}</span> — ${c} visit${c>1?'s':''}</li>`).join('')}</ul></div></div>`);
  if(searches.length) cards.push(`<div class="report-card neutral"><div class="rc-head"><span class="rc-icon">🔍</span><span class="rc-title">Search Activity</span><span class="rc-badge"><span class="tl-badge badge-search">${searches.length} searches</span></span></div><div class="rc-body">${sq.length?`<ul>${sq.map(q=>`<li>"${esc(q)}"</li>`).join('')}${sq.length<searches.length?`<li style="color:var(--muted)">...and ${searches.length-sq.length} more</li>`:''}</ul>`:`<p>${searches.length} searches recorded.</p>`}</div></div>`);
  if(dls.length) cards.push(`<div class="report-card ${exe.length?'warning':'neutral'}"><div class="rc-head"><span class="rc-icon">⬇</span><span class="rc-title">Downloads</span><span class="rc-badge"><span class="tl-badge badge-dl">${dls.length} files</span></span></div><div class="rc-body"><ul>${dls.map(e=>`<li><span class="${exe.includes(e)?'warn':'highlight'}">${esc(fname(e.url))}</span> from ${getDomain(e.url)}</li>`).join('')}</ul>${exe.length?`<p class="warn" style="margin-top:0.6rem">⚠ ${exe.length} executable${exe.length>1?'s':''} downloaded — verify sources.</p>`:''}</div></div>`);
  if(social.length||video.length) cards.push(`<div class="report-card neutral"><div class="rc-head"><span class="rc-icon">📱</span><span class="rc-title">Social &amp; Entertainment</span></div><div class="rc-body"><ul>${social.length?`<li>Social: <span class="highlight">${social.length} visits</span> (${[...new Set(social.map(e=>e.domain))].join(', ')})</li>`:''}${video.length?`<li>Video/streaming: <span class="highlight">${video.length} visits</span></li>`:''}</ul></div></div>`);
  document.getElementById('report').innerHTML=cards.join('');
}

